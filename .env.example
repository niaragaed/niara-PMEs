# Copy this file to .env.local and fill in the values (never commit .env.local;
# .env* is already in .gitignore).

# Supabase Postgres project. The URL and the anon key are public by design (the
# anon key only grants access according to the database's RLS policies).
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_...: public by design, protected by Postgres RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# sb_secret_...: BYPASSES RLS entirely. Never on the client, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres through the pooler (sa-east-1). If the password has a special
# character, URL-encode it before pasting it here (e.g. "@" -> "%40").
DATABASE_URL=
DIRECT_URL=

# NIARA_ENV=demo makes the front end never show mock data as if it were real.
NIARA_ENV=demo

# Ports & adapters (src/lib/adapters.ts): "mock" is the only value implemented
# so far; any missing/unknown value also falls back to the mock.
NIARA_PAYMENT_ADAPTER=mock
NIARA_KYC_ADAPTER=mock
NIARA_CHAIN_ADAPTER=mock

# Optional, only for `npm run seed:demo` (scripts/seed-demo.ts). If missing, the
# script generates a random password and prints it once in the terminal; it is
# never saved to any file.
NIARA_DEMO_PASSWORD=

# Dedicated Sepolia RPC (Alchemy/Infura/etc.) used by ALL reads in this app:
# publicClient() on the server (onchain-actions.ts, events.ts/eventsCore.ts) and the client's wagmi
# config (src/lib/web3/config.ts). Optional in theory (without it, the transport falls back to
# viem/chains' default public Sepolia RPC, currently https://11155111.rpc.thirdweb.com), but NEVER
# leave it unset in production: the public RPC is rate-limited and, in the real incident documented
# in CLAUDE.md ("/invest/onchain screen": strict read gate), failed reads on that RPC already
# produced a stale allowance treated as sufficient, wrongly skipping the approve. It has nothing to
# do with SEPOLIA_RPC_URL (without NEXT_PUBLIC_) in the niara-contracts-PMEs repository: different
# variables, files and purposes (that one is only for the contracts' `cast`/`forge script` commands).
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Real investment on Sepolia (/invest/onchain): addresses of the contracts the front end actually
# reads/writes. MockBRL is the infrastructure already deployed and verified for the "Phase 4" demo
# of niara-contracts-PMEs (see DEMO_SECUNDARIO_SEPOLIA.md in that repository). It is shared by the
# 10 legacy offerings (one address); self-service offerings each have their own (read from
# OfertaCaptacao.moeda()).
NEXT_PUBLIC_MOCKBRL_ADDRESS=

# List of demo offerings (one or more; the UI shows a selector when there is more than one, meant
# for an in-person demo to switch offerings between visitors without a new deploy). Each offering is
# created by script/DemoNiaraPMEsOnChain.s.sol (run outside this project, by whoever holds the
# deployer key with AGENTE_ROLE). Copy the "token:offering" pair printed at the end of that script;
# for several, separate the pairs with ";".
# Format: token1:offering1;token2:offering2;...
# Without MockBRL and at least 1 offering filled in, the page shows "contract not configured"
# instead of breaking.
NEXT_PUBLIC_OFERTAS_ONCHAIN=

# Internal /partners dashboard: email allowlist (comma-separated) allowed to see the dashboard after
# signing in through Supabase Auth. Never hardcode real emails in the code (public repo); fill this
# in only in your .env.local / the deployment's env vars.
NIARA_SOCIOS_EMAILS=

# Self-service publication of the offering on Sepolia by the issuer itself (Phase 3, see
# PLANO_FASE_3_PUBLICACAO_ONCHAIN.md): address of the already deployed and verified
# OfertaOrquestrador (niara-contracts-PMEs/DEMO_SEPOLIA.md). Without it, the gate 4 read
# (emissoresAutorizados) shows "contract not configured" instead of breaking.
NEXT_PUBLIC_ORQUESTRADOR_ADDRESS=

# Solana Devnet (niara-pmes-solana program): all optional; the defaults are already the real devnet
# values. Only override them to point to a local validator.
# NEXT_PUBLIC_PMES_SOLANA_PROGRAM_ID=FKefGFhUmgXBM1xCtSFBWpoNnp3wuPJs6Yddpsp67J2y
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_EXPLORER_CLUSTER=devnet
