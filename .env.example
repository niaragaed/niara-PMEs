# Copie este arquivo para .env.local e preencha os valores (nunca commitar
# .env.local — .env* já está no .gitignore).

# Supabase — projeto Postgres. URL e anon key são públicas por design (a
# anon key só concede acesso conforme as políticas de RLS do banco).
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... — pública por design, protegida pelo RLS do Postgres.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# sb_secret_... — BYPASSA o RLS inteiro. Nunca no cliente, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres via pooler (sa-east-1). Se a senha tiver caractere especial,
# faça URL-encoding antes de colar aqui (ex.: "@" -> "%40").
DATABASE_URL=
DIRECT_URL=

# NIARA_ENV=demo faz o front nunca exibir dado mock como se fosse real.
NIARA_ENV=demo

# Adapters de ports & adapters (src/lib/adapters.ts) — "mock" é o único
# valor implementado por ora; qualquer valor ausente/desconhecido também
# cai no mock.
NIARA_PAYMENT_ADAPTER=mock
NIARA_KYC_ADAPTER=mock
NIARA_CHAIN_ADAPTER=mock

# Opcional, só para `npm run seed:demo` (scripts/seed-demo.ts). Se ausente,
# o script gera uma senha aleatória e imprime uma única vez no terminal —
# nunca fica salva em arquivo nenhum.
NIARA_DEMO_PASSWORD=

# Investimento real em Sepolia (/investir/onchain) — endereços dos contratos que o frontend
# lê/escreve de verdade. MockBRL é a infraestrutura já implantada e verificada da demo "Fase 4"
# do niara-contracts-PMEs (ver DEMO_SECUNDARIO_SEPOLIA.md naquele repositório) — compartilhado
# por todas as ofertas, um único endereço.
NEXT_PUBLIC_MOCKBRL_ADDRESS=

# Lista de ofertas de demonstração (uma ou várias — a UI mostra um seletor quando há mais de
# uma, pensado para demo presencial trocar de oferta entre visitantes sem precisar de novo
# deploy). Cada oferta é criada por script/DemoNiaraPMEsOnChain.s.sol (rodado fora deste
# projeto, por quem tiver a chave do deployer com AGENTE_ROLE) — copie o par
# "token:oferta" impresso no fim daquele script; para várias, separe os pares com ";".
# Formato: token1:oferta1;token2:oferta2;...
# Sem MockBRL nem ao menos 1 oferta preenchidos, a página mostra "contrato não configurado" em
# vez de quebrar.
NEXT_PUBLIC_OFERTAS_ONCHAIN=

# Painel interno /socios — allowlist de e-mail (separados por vírgula) autorizados a ver o
# painel depois de logar via Supabase Auth. Nunca hardcodar e-mails reais no código (repo
# público) — preencha só no seu .env.local / nas env vars do deploy.
NIARA_SOCIOS_EMAILS=
